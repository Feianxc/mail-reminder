<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="860" Height="560" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextElement.FontFamily="Microsoft YaHei UI, Segoe UI" TextElement.Foreground="{DynamicResource TextBrush}">
  <Grid.Resources>
    <Style x:Key="Cap" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Num" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource NumFont}"/>
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style x:Key="Icon" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="StrokeThickness" Value="1.4"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <DrawingBrush x:Key="DotGrid" TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,14,14"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#FFFFFFFF">
            <GeometryDrawing.Geometry><EllipseGeometry Center="7,7" RadiusX="0.7" RadiusY="0.7"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Grid.Resources>

  <!-- 窗体：石墨底 + 顶部微光 -->
  <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12"/>
  <Border CornerRadius="12" IsHitTestVisible="False">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0EFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.22"/>
      </LinearGradientBrush>
    </Border.Background>
  </Border>
  <Grid Margin="1" RenderOptions.ClearTypeHint="Enabled">
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition/><RowDefinition Height="38"/></Grid.RowDefinitions>

    <!-- 标题栏：整条可拖动 -->
    <Grid x:Name="DragBar" Background="Transparent">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
        <Grid Width="18" Height="18" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource SignalBrush}"/>
          <Path Stroke="{DynamicResource SignalBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4.4,4.4 A6.5,6.5 0 0 0 4.4,13.6 M13.6,4.4 A6.5,6.5 0 0 1 13.6,13.6"/>
        </Grid>
        <TextBlock Text="邮件提醒助手" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Text="/" FontSize="13" Margin="10,0" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
        <TextBlock x:Name="RoomName" Style="{StaticResource Cap}" FontSize="12.5" MaxWidth="280"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
        <Border CornerRadius="11" Padding="3" Margin="0,0,10,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="TechTheme" Style="{DynamicResource ThemeButton}" Tag="selected" Content="高科技" ToolTip="当前为高科技主题"/>
            <Button x:Name="CosmosTheme" Style="{DynamicResource ThemeButton}" Content="宇宙星空" ToolTip="切换到宇宙星空主题" Margin="2,0,0,0"/>
          </StackPanel>
        </Border>
        <Button x:Name="SettingsButton" Style="{DynamicResource ChromeButton}" Width="34" Height="30" ToolTip="设置">
          <Path Style="{StaticResource Icon}" Data="M1,4 H7 M11,4 H15 M1,12 H4 M8,12 H15 M9,2 A2,2 0 1 0 9.01,2 Z M6,10 A2,2 0 1 0 6.01,10 Z"/>
        </Button>
        <Button x:Name="MinimizeButton" Style="{DynamicResource ChromeButton}" Width="34" Height="30" ToolTip="最小化到任务栏">
          <Path Style="{StaticResource Icon}" Data="M2,8 H14"/>
        </Button>
        <Button x:Name="CloseButton" Style="{DynamicResource CloseChromeButton}" Width="34" Height="30" ToolTip="隐藏到托盘，继续接收警告">
          <Path Style="{StaticResource Icon}" Data="M3,3 L13,13 M13,3 L3,13"/>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="20,4,20,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="272"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="16"/><RowDefinition Height="104"/></Grid.RowDefinitions>

      <!-- 广播：点阵背景上的精密旋钮 -->
      <Border Style="{StaticResource Panel}"/>
      <Rectangle Margin="1" Fill="{StaticResource DotGrid}" Opacity="0.22" IsHitTestVisible="False">
        <Rectangle.OpacityMask>
          <RadialGradientBrush RadiusX="0.62" RadiusY="0.8">
            <GradientStop Color="#FF000000" Offset="0.3"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.OpacityMask>
        <Rectangle.CacheMode><BitmapCache/></Rectangle.CacheMode>
      </Rectangle>
      <TextBlock Text="广播警告" Style="{StaticResource Cap}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,16,0,0"/>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Padding="10,4" MaxWidth="230" CornerRadius="7"
              Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ToolTip="全局快捷键，任何窗口下都可触发">
        <TextBlock x:Name="HotkeyText" Text="Ctrl + Alt + F9" FontFamily="{DynamicResource NumFont}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
      </Border>
      <Grid Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Ellipse x:Name="AmbientGlow" Width="292" Height="292" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#38FF8A3D" Offset="0.45"/>
              <GradientStop Color="#00FF8A3D" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <!-- 外圈：两段对称弧线缓慢巡航 -->
        <Ellipse x:Name="AmbientOrbit" Width="296" Height="296" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeDashArray="92 216.4" StrokeDashCap="Round" Opacity="0.85" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
        </Ellipse>
        <!-- 72 格刻度 -->
        <Ellipse Width="272" Height="272" Stroke="{DynamicResource FaintBrush}" StrokeThickness="6" StrokeDashArray="0.25 1.6844" Opacity="0.8" IsHitTestVisible="False"/>
        <Ellipse x:Name="AmbientOrbitB" Width="244" Height="244" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeDashArray="0.5 2.6678" Opacity="0.45" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="216" Height="216" Stroke="{DynamicResource LineBrush}" StrokeThickness="1" IsHitTestVisible="False"/>
        <Ellipse x:Name="SignalPulse" Width="200" Height="200" Stroke="{DynamicResource SignalBrush}" StrokeThickness="2" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="SignalPulseB" Width="200" Height="200" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
        </Ellipse>
        <Button x:Name="SendButton" Width="196" Height="196" Style="{DynamicResource TechAction}" ToolTip="向全部在线同事发出警告">
          <StackPanel Width="164" VerticalAlignment="Center">
            <Grid Width="64" Height="16" HorizontalAlignment="Center">
              <Ellipse>
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Color="#80FF8A3D" Offset="0"/>
                    <GradientStop Color="#00FF8A3D" Offset="1"/>
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Border Width="28" Height="4" CornerRadius="2" Background="{DynamicResource ActionBrush}"/>
            </Grid>
            <TextBlock x:Name="ActionTitle" Text="收到一封加急邮件，请立刻处理" FontSize="24" FontWeight="Bold" TextOptions.TextFormattingMode="Ideal" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
            <TextBlock x:Name="ActionHint" Text="发送给全部在线同事" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
          </StackPanel>
        </Button>
        <!-- 冷却进度：发送后 5 秒沿环回退 -->
        <Ellipse x:Name="CooldownGauge" Width="216" Height="216" Stroke="{DynamicResource SignalBrush}" StrokeThickness="3" StrokeDashArray="223.05 400" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
        </Ellipse>
      </Grid>

      <!-- 回执：文字摘要 + 两个真实计数 -->
      <Border Grid.Row="2" Style="{StaticResource Panel}"/>
      <Grid Grid.Row="2" Margin="18,0,8,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="112"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Text="本次回执" Style="{StaticResource Cap}" HorizontalAlignment="Left"/>
          <TextBlock x:Name="ReceiptSummary" FontSize="13" LineHeight="21" MaxHeight="42" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Margin="0,20" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" ToolTip="对方软件已收到警告">
          <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
            <TextBlock x:Name="ReceivedCount" Text="—" Style="{StaticResource Num}" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="软件收到" Style="{StaticResource Cap}" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Margin="0,20" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" ToolTip="同事本人已点击“知道了”">
          <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
            <TextBlock x:Name="SeenCount" Text="—" Style="{StaticResource Num}" Foreground="{DynamicResource SignalBrush}"/>
            <TextBlock Text="已知晓" Style="{StaticResource Cap}" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 在线同事 -->
      <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Panel}"/>
      <DockPanel Grid.Column="2" Grid.RowSpan="3" Margin="16,14,8,14">
        <Grid DockPanel.Dock="Top" Margin="0,0,8,0">
          <StackPanel HorizontalAlignment="Left">
            <TextBlock Text="在线同事" FontSize="14" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
              <Ellipse x:Name="AmbientDot" Width="7" Height="7" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center" Margin="1,1,7,0"/>
              <TextBlock x:Name="ConnectionText" Style="{StaticResource Cap}" MaxWidth="170"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="OnlineCount" Text="0" Style="{StaticResource Num}" FontSize="34" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Button x:Name="TestButton" DockPanel.Dock="Bottom" Height="36" Margin="0,10,8,0" ToolTip="向在线同事发送一次联机测试，不算正式警告">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Icon}" Margin="0,0,8,0" Data="M1,7 H4 L6,2 L9,12 L11,7 H14"/>
            <TextBlock Text="联机测试" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Grid Margin="0,12,0,0">
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,8,0"/>
          <TextBlock x:Name="EmptyPeers" Text="暂无在线同事&#x0a;同事打开软件后会出现在这里" Style="{StaticResource Cap}" LineHeight="20" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="8,0,16,0"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0" Focusable="False">
            <ItemsControl x:Name="PeerList" ItemTemplate="{DynamicResource PeerRow}" Focusable="False" Margin="0,0,8,0"/>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Grid>

    <!-- 底栏：网络信息或错误提示 -->
    <DockPanel Grid.Row="2" Margin="22,0,22,0">
      <Path DockPanel.Dock="Left" VerticalAlignment="Center" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 H13 V9 H1 Z M4,12.5 H10 M7,9 V12.5"/>
      <TextBlock x:Name="NetworkText" Style="{StaticResource Cap}" Margin="9,0,0,0"/>
    </DockPanel>
  </Grid>
</Grid>
