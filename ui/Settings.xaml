<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="500" Height="580" TextElement.FontFamily="Microsoft YaHei UI, Segoe UI" TextElement.Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid.Resources>
    <Geometry x:Key="IcoFloat">M10,3 A7,7 0 1 1 9.99,3 Z M10,7.5 A2.5,2.5 0 1 1 9.99,7.5 Z</Geometry>
    <Geometry x:Key="IcoSound">M3,8 H6 L10,4 V16 L6,12 H3 Z M13,7 C14.5,8.5 14.5,11.5 13,13 M15.5,5 C18,7.5 18,12.5 15.5,15</Geometry>
    <Geometry x:Key="IcoMotion">M3,6 H12 M3,10 H17 M3,14 H9</Geometry>
    <Geometry x:Key="IcoStartup">M10,3 V9 M6,5.5 A6,6 0 1 0 14,5.5</Geometry>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Margin" Value="2,0,0,8"/>
    </Style>
    <!-- 主题卡片：缩略预览 + 名称，选中后显示描边与对勾 -->
    <Style x:Key="ThemeCard" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="Bd" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
          <Border x:Name="Hover" CornerRadius="12" Background="#0CFFFFFF" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1" Opacity="0"/>
          <Border x:Name="Pick" CornerRadius="12" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Opacity="0"/>
          <ContentPresenter Margin="10"/>
          <Grid x:Name="Tick" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,13" Visibility="Hidden">
            <Ellipse Fill="{DynamicResource AccentBrush}"/>
            <Path Data="M5,9.2 L8,12 L13,6.5" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Grid>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="Tag" Value="selected">
            <Setter TargetName="Pick" Property="Opacity" Value="1"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
  <Border Grid.RowSpan="3" CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
  <Image x:Name="CosmicImage" Grid.RowSpan="3" Height="220" VerticalAlignment="Top" Stretch="UniformToFill" Opacity="0.32" IsHitTestVisible="False">
    <Image.Clip><RectangleGeometry Rect="1,1,498,260" RadiusX="13" RadiusY="13"/></Image.Clip>
    <Image.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Image.OpacityMask>
  </Image>
  <Grid x:Name="DragBar" Background="Transparent">
    <StackPanel Orientation="Horizontal" Margin="28,6,0,0" VerticalAlignment="Center">
      <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
      <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0"/>
      <TextBlock Text="邮件提醒助手" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="10,5,0,0"/>
    </StackPanel>
  </Grid>
  <Button x:Name="CancelTop" Style="{DynamicResource ChromeButton}" Width="32" Height="32" HorizontalAlignment="Right" Margin="0,6,16,0" ToolTip="关闭" AutomationProperties.Name="关闭">
    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
  </Button>
  <StackPanel Grid.Row="1" Margin="28,8,28,0" RenderOptions.ClearTypeHint="Enabled">
    <DockPanel>
      <TextBlock DockPanel.Dock="Right" Text="最多 24 字" Style="{StaticResource Caption}" Foreground="{DynamicResource FaintBrush}" Margin="0,0,2,8"/>
      <TextBlock Text="同事看到的名称" Style="{StaticResource Caption}"/>
    </DockPanel>
    <TextBox x:Name="DisplayName" Height="40" MaxLength="24" AutomationProperties.Name="同事看到的名称"/>
    <TextBlock Text="界面主题 · 点选即可预览，保存后生效" Style="{StaticResource Caption}" Margin="2,18,0,8"/>
    <Grid Height="112">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="TechTheme" Style="{StaticResource ThemeCard}" AutomationProperties.Name="高科技主题">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="48" CornerRadius="7" Background="#FF0A0C10" BorderBrush="#FF262C37" BorderThickness="1">
            <Grid>
              <Ellipse Width="36" Height="36" Stroke="#FF586273" StrokeThickness="3" StrokeDashArray="0.3 1.428"/>
              <Ellipse Width="24" Height="24" Stroke="#FF050608" StrokeThickness="1">
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF14171D" Offset="0"/>
                    <GradientStop Color="#FF2A313D" Offset="1"/>
                  </LinearGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Border Width="10" Height="3" CornerRadius="1.5" Background="#FFFF8A3D"/>
              <Path Stroke="#FF7FD8FF" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M22,14 H50 M146,14 H174 M22,34 H40 M156,34 H174" Opacity="0.55"/>
            </Grid>
          </Border>
          <StackPanel Margin="2,8,0,0">
            <TextBlock Text="高科技" FontSize="13.5" FontWeight="SemiBold"/>
            <TextBlock Text="石墨仪表 · 琥珀信号" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
      </Button>
      <Button x:Name="CosmosTheme" Grid.Column="2" Style="{StaticResource ThemeCard}" AutomationProperties.Name="宇宙星空主题">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="48" CornerRadius="7" BorderBrush="#33D8D5FF" BorderThickness="1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF080920" Offset="0"/>
                <GradientStop Color="#FF211850" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Path Fill="#B3FFFFFF" Data="M24,12 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M168,30 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M150,10 a0.8,0.8 0 1 0 1.6,0 a0.8,0.8 0 1 0 -1.6,0 M44,34 a0.8,0.8 0 1 0 1.6,0 a0.8,0.8 0 1 0 -1.6,0"/>
              <Ellipse Width="42" Height="42">
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Color="#00FFE2B8" Offset="0.48"/>
                    <GradientStop Color="#E6FFE8C8" Offset="0.58"/>
                    <GradientStop Color="#59FFB27A" Offset="0.72"/>
                    <GradientStop Color="#00A48BFF" Offset="1"/>
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Ellipse Width="24" Height="24" Fill="#FF05050E"/>
            </Grid>
          </Border>
          <StackPanel Margin="2,8,0,0">
            <TextBlock Text="宇宙星空" FontSize="13.5" FontWeight="SemiBold"/>
            <TextBlock Text="深空星云 · 日食光环" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
      </Button>
    </Grid>
    <!-- 开关行使用 Common.xaml 的 CheckBox 样式，Tag 提供图标 -->
    <Border Margin="0,16,0,0" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
      <StackPanel>
        <CheckBox x:Name="FloatingOption" Tag="{StaticResource IcoFloat}" Content="显示桌面悬浮球"/>
        <Rectangle Height="1" Margin="48,0,0,0" Fill="{DynamicResource LineBrush}"/>
        <CheckBox x:Name="SoundOption" Tag="{StaticResource IcoSound}" Content="收到提醒时播放声音"/>
        <Rectangle Height="1" Margin="48,0,0,0" Fill="{DynamicResource LineBrush}"/>
        <CheckBox x:Name="MotionOption" Tag="{StaticResource IcoMotion}" Content="关闭动态效果"/>
        <Rectangle Height="1" Margin="48,0,0,0" Fill="{DynamicResource LineBrush}"/>
        <CheckBox x:Name="StartupOption" Tag="{StaticResource IcoStartup}" Content="登录 Windows 后自动启动"/>
      </StackPanel>
    </Border>
  </StackPanel>
  <Grid Grid.Row="2" Margin="28,0,28,8">
    <Button x:Name="PreviewButton" Content="预览本机通知" Height="40" MinWidth="136" Padding="16,0" FontSize="13.5" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="只在本机弹出一条通知，不会发给同事"/>
    <Button x:Name="SaveButton" Style="{DynamicResource AccentButton}" Content="保存设置" Height="40" MinWidth="136" Padding="20,0" FontSize="13.5" IsDefault="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
  </Grid>
</Grid>
