<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="500" Height="430" TextElement.FontFamily="Microsoft YaHei UI, Segoe UI" TextElement.Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
  <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
  <Grid Margin="28,20,28,26">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="68"/><RowDefinition Height="48"/><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Grid x:Name="DragBar" Background="Transparent"><TextBlock Text="手机绑定" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button x:Name="CloseButton" Content="×" Style="{DynamicResource ChromeButton}" HorizontalAlignment="Right"/></Grid>
    <StackPanel Grid.Row="1" Margin="0,8,0,0"><TextBlock x:Name="SubnetText" FontSize="14"/><TextBlock x:Name="ConnectionText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0"/></StackPanel>
    <Button x:Name="CreateCodeButton" Grid.Row="2" Content="生成手机绑定码" Style="{DynamicResource AccentButton}"/>
    <Border Grid.Row="3" Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PairCodeText" Text="— — — —" FontFamily="{DynamicResource NumFont}" FontSize="30" TextAlignment="Center"/>
        <TextBlock x:Name="ExpiryText" Text="在安卓端输入此处生成的绑定码" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel>
    </Border>
    <StackPanel Grid.Row="4" VerticalAlignment="Center"><TextBlock Text="手机安装入口" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
      <TextBox x:Name="InstallUrl" IsReadOnly="True" FontSize="12"/>
    </StackPanel>
    <Button x:Name="CopyUrlButton" Grid.Row="5" Content="复制安装入口"/>
  </Grid>
</Grid>
