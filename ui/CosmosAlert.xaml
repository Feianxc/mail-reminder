<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="440" Height="232" Tag="side" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextElement.FontFamily="Microsoft YaHei UI, Segoe UI" TextElement.Foreground="{DynamicResource TextBrush}">
  <!-- Tag="side"：由屏幕右侧滑入。卡片四周留白用于投影 -->
  <Border Margin="16,12,16,20" CornerRadius="16" Background="{DynamicResource MenuBrush}">
    <Border.Effect><DropShadowEffect Color="#FF03030A" BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.55"/></Border.Effect>
  </Border>
  <Image x:Name="CosmicImage" Margin="16,12,16,20" Stretch="UniformToFill" Opacity="0.5" IsHitTestVisible="False">
    <Image.Clip><RectangleGeometry Rect="0,0,408,200" RadiusX="16" RadiusY="16"/></Image.Clip>
  </Image>
  <Border Margin="16,12,16,20" CornerRadius="16" BorderThickness="1" IsHitTestVisible="False">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8C1B1A4D" Offset="0"/>
        <GradientStop Color="#D90A0A1F" Offset="0.55"/>
        <GradientStop Color="#F0060612" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.4"/>
        <GradientStop Color="#14FFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
  </Border>
  <!-- 闪烁的星点 -->
  <Path x:Name="AmbientDot" Fill="#FFFFFFFF" IsHitTestVisible="False"
        Data="M392,70 L392.8,73.2 396,74 392.8,74.8 392,78 391.2,74.8 388,74 391.2,73.2 Z M366,61.5 L366.5,63.5 368.5,64 366.5,64.5 366,66.5 365.5,64.5 363.5,64 365.5,63.5 Z"/>
  <Grid Margin="36,30,36,38" RenderOptions.ClearTypeHint="Enabled">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="40"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="70"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <!-- 徽标：迷你日食，与悬浮球同一图形 -->
    <Grid Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0">
      <Ellipse x:Name="AmbientGlow" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#00FFE2B8" Offset="0.44"/>
            <GradientStop Color="#F2FFE8C8" Offset="0.54"/>
            <GradientStop Color="#66FFB27A" Offset="0.68"/>
            <GradientStop Color="#00A48BFF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse x:Name="SignalPulse" Margin="8" Stroke="{DynamicResource SignalBrush}" StrokeThickness="2" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
      </Ellipse>
      <Grid x:Name="AmbientOrbit" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><RotateTransform Angle="0"/></Grid.RenderTransform>
        <Ellipse Width="4" Height="4" Fill="#FFFFF4DC" HorizontalAlignment="Center" VerticalAlignment="Top"/>
      </Grid>
      <Ellipse Width="30" Height="30" Fill="#FF06060F" StrokeThickness="1">
        <Ellipse.Stroke>
          <LinearGradientBrush StartPoint="0.85,0.1" EndPoint="0.15,0.9">
            <GradientStop Color="#FFFFF4DC" Offset="0"/>
            <GradientStop Color="#40B4A0FF" Offset="1"/>
          </LinearGradientBrush>
        </Ellipse.Stroke>
      </Ellipse>
      <Path Fill="{DynamicResource ActionBrush}" Data="M28,21 L29.5,26.5 35,28 29.5,29.5 28,35 26.5,29.5 21,28 26.5,26.5 Z"/>
    </Grid>
    <StackPanel Grid.Column="1" VerticalAlignment="Top">
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="AlertTime" DockPanel.Dock="Right" Text="--:--" FontFamily="{DynamicResource NumFont}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <Border HorizontalAlignment="Left" CornerRadius="10" Background="#29FFD29A" Padding="9,2,9,3">
          <TextBlock x:Name="AlertKind" Text="邮件提醒助手" FontSize="11.5" Foreground="{DynamicResource SignalBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>
      </DockPanel>
      <TextBlock x:Name="AlertTitle" Text="收到一封加急邮件，请立刻处理" FontSize="26" FontWeight="Light" TextOptions.TextFormattingMode="Ideal" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="AlertDetails" FontSize="12.5" LineHeight="20" MaxHeight="40" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <Button x:Name="SeenButton" Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource AccentButton}" Background="{DynamicResource ActionBrush}" Foreground="#FF1D1408" Padding="0" IsDefault="True" ToolTip="确认后发送方会看到“已知晓”">
      <StackPanel Orientation="Horizontal">
        <Path Data="M1,6 L5,10 L13,1" Stroke="#FF1D1408" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Text="知道了" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Button>
  </Grid>
</Grid>
