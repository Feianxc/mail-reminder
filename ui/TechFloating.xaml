<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="96" Height="96" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid.Resources>
    <ControlTemplate x:Key="BallTemplate" TargetType="Button">
      <Grid Background="Transparent">
        <!-- 金属外圈 + 内凹键帽 -->
        <Ellipse>
          <Ellipse.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#FF4B5362" Offset="0"/>
              <GradientStop Color="#FF1A1E26" Offset="0.5"/>
              <GradientStop Color="#FF08090C" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
          <Ellipse.Effect><DropShadowEffect Color="#FF000000" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.5"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Margin="2.5" Stroke="#FF050608" StrokeThickness="1">
          <Ellipse.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#FF14171D" Offset="0"/>
              <GradientStop Color="#FF262C38" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse x:Name="Hover" Margin="2.5" Stroke="{DynamicResource SignalBrush}" StrokeThickness="1.5" Opacity="0" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.8" RadiusY="0.8">
              <GradientStop Color="#55FF7A30" Offset="0"/>
              <GradientStop Color="#00FF7A30" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse x:Name="Focus" Margin="-3" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Opacity="0" IsHitTestVisible="False"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Hover" Property="Opacity" Value="1"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="Focus" Property="Opacity" Value="0.9"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Grid.Resources>

  <Ellipse x:Name="SignalPulse" Width="72" Height="72" Stroke="{DynamicResource SignalBrush}" StrokeThickness="2"
           Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
    <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
  </Ellipse>
  <!-- 两段冰蓝弧线环绕 -->
  <Ellipse x:Name="AmbientOrbit" Width="86" Height="86" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
           StrokeDashArray="26 62.49" StrokeDashCap="Round" Opacity="0.9" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
    <Ellipse.RenderTransform><RotateTransform Angle="0"/></Ellipse.RenderTransform>
  </Ellipse>

  <Button x:Name="BallSurface" Width="72" Height="72" Template="{StaticResource BallTemplate}" Cursor="Hand"
          Background="Transparent" BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}"
          AutomationProperties.Name="邮件提醒助手悬浮球">
    <Canvas Width="72" Height="72" IsHitTestVisible="False">
      <Ellipse Canvas.Left="22" Canvas.Top="22" Width="28" Height="28">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#73FF8A3D" Offset="0"/>
            <GradientStop Color="#00FF8A3D" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Canvas.Left="31" Canvas.Top="31" Width="10" Height="10" Fill="{DynamicResource ActionBrush}"/>
      <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M25,25 A15.5,15.5 0 0 0 25,47 M47,25 A15.5,15.5 0 0 1 47,47"/>
      <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.45"
            Data="M19,19 A24,24 0 0 0 19,53 M53,19 A24,24 0 0 1 53,53"/>
    </Canvas>
  </Button>

  <!-- 冷却：环形倒计时 + 秒数 -->
  <Ellipse x:Name="CooldownGauge" Width="80" Height="80" Stroke="{DynamicResource SignalBrush}" StrokeThickness="2.5"
           StrokeDashArray="97.39 200" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
    <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
  </Ellipse>
  <Border Width="67" Height="67" CornerRadius="33.5" Background="#EB0C0E12" IsHitTestVisible="False"
          Visibility="{Binding Visibility, ElementName=ActionTitle}"/>
  <TextBlock x:Name="ActionTitle" Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="60"
             HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
             FontFamily="{DynamicResource NumFont}" FontSize="21" Foreground="{DynamicResource TextBrush}"/>
</Grid>
