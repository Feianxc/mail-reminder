<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="860" Height="560" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextElement.FontFamily="Microsoft YaHei UI, Segoe UI" TextElement.Foreground="{DynamicResource TextBrush}">
  <Grid.Resources>
    <Style x:Key="Cap" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Num" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource NumFont}"/>
      <Setter Property="FontSize" Value="32"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Icon" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="StrokeThickness" Value="1.4"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#55FFFFFF" Offset="0"/>
      <GradientStop Color="#16FFFFFF" Offset="0.4"/>
      <GradientStop Color="#0CFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="Glass" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
    </Style>
  </Grid.Resources>
  <Grid.Clip><RectangleGeometry Rect="0,0,860,560" RadiusX="14" RadiusY="14"/></Grid.Clip>

  <!-- 星云背景 -->
  <Rectangle Fill="{DynamicResource BackgroundBrush}"/>
  <Image x:Name="CosmicImage" Stretch="UniformToFill" Opacity="0.92" IsHitTestVisible="False"/>
  <Rectangle IsHitTestVisible="False">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A6060714" Offset="0"/>
        <GradientStop Color="#33060714" Offset="0.4"/>
        <GradientStop Color="#CC060714" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>
  <!-- 日食背后的紫色辉光 -->
  <Rectangle IsHitTestVisible="False">
    <Rectangle.Fill>
      <RadialGradientBrush Center="0.334,0.42" GradientOrigin="0.334,0.42" RadiusX="0.4" RadiusY="0.6">
        <GradientStop Color="#477A63FF" Offset="0"/>
        <GradientStop Color="#007A63FF" Offset="1"/>
      </RadialGradientBrush>
    </Rectangle.Fill>
  </Rectangle>
  <Border CornerRadius="14" BorderThickness="1" BorderBrush="#3DFFFFFF" IsHitTestVisible="False"/>

  <!-- 标题栏 -->
  <Grid RenderOptions.ClearTypeHint="Enabled">
  <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition/><RowDefinition Height="38"/></Grid.RowDefinitions>
  <Grid x:Name="DragBar" Background="Transparent">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0">
      <Path Data="M8,0 L9.6,6.4 L16,8 L9.6,9.6 L8,16 L6.4,9.6 L0,8 L6.4,6.4 Z" Fill="{DynamicResource ActionBrush}" VerticalAlignment="Center"/>
      <TextBlock Text="邮件提醒助手" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
      <Rectangle Width="1" Height="13" Fill="{DynamicResource LineBrush}" Margin="12,1,12,0"/>
      <TextBlock x:Name="RoomName" Style="{StaticResource Cap}" FontSize="12.5" MaxWidth="280"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
      <Border CornerRadius="11" Padding="3" Margin="0,0,10,0" Background="#59050510" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="TechTheme" Style="{DynamicResource ThemeButton}" Content="高科技" ToolTip="切换到高科技主题"/>
          <Button x:Name="CosmosTheme" Style="{DynamicResource ThemeButton}" Tag="selected" Content="宇宙星空" ToolTip="当前为宇宙星空主题" Margin="2,0,0,0"/>
        </StackPanel>
      </Border>
      <Button x:Name="SettingsButton" Style="{DynamicResource ChromeButton}" Width="34" Height="30" ToolTip="设置">
        <Path Style="{StaticResource Icon}" Data="M1,4 H7 M11,4 H15 M1,12 H4 M8,12 H15 M9,2 A2,2 0 1 0 9.01,2 Z M6,10 A2,2 0 1 0 6.01,10 Z"/>
      </Button>
      <Button x:Name="MinimizeButton" Style="{DynamicResource ChromeButton}" Width="34" Height="30" ToolTip="最小化到任务栏">
        <Path Style="{StaticResource Icon}" Data="M2,8 H14"/>
      </Button>
      <Button x:Name="CloseButton" Style="{DynamicResource CloseChromeButton}" Width="34" Height="30" ToolTip="隐藏到托盘，继续接收警告">
        <Path Style="{StaticResource Icon}" Data="M3,3 L13,13 M13,3 L3,13"/>
      </Button>
    </StackPanel>
  </Grid>

  <!-- 主体 -->
  <Grid Grid.Row="1" Margin="24,4,24,6">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="264"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="14"/><RowDefinition Height="100"/></Grid.RowDefinitions>

    <!-- 光环与广播 -->
    <Grid>
      <!-- 闪烁的星点 -->
      <Path x:Name="AmbientDot" Fill="#FFFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
            Data="M62,65 L63,69 67,70 63,71 62,75 61,71 57,70 61,69 Z M470,92 L470.8,95.2 474,96 470.8,96.8 470,100 469.2,96.8 466,96 469.2,95.2 Z M60,286.5 L60.7,289.3 63.5,290 60.7,290.7 60,293.5 59.3,290.7 56.5,290 59.3,289.3 Z M476,265 L476.6,267.4 479,268 476.6,268.6 476,271 475.4,268.6 473,268 475.4,267.4 Z"/>
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="344" Height="344">
        <!-- 呼吸的外层日冕 -->
        <Ellipse x:Name="AmbientGlow" Width="320" Height="320" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#00FFD9A8" Offset="0.6"/>
              <GradientStop Color="#5CFFD9A8" Offset="0.68"/>
              <GradientStop Color="#29A48BFF" Offset="0.8"/>
              <GradientStop Color="#00A48BFF" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse x:Name="AmbientOrbitB" Width="340" Height="340" Stroke="#59FFFFFF" StrokeThickness="1" StrokeDashArray="1 8 27.375 8" StrokeDashCap="Round"
                 RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
          <Ellipse.RenderTransform><RotateTransform Angle="0"/></Ellipse.RenderTransform>
        </Ellipse>
        <!-- 轨道与绕行的卫星 -->
        <Ellipse Width="300" Height="300" Stroke="#24FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
        <Grid x:Name="AmbientOrbit" Width="300" Height="300" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
          <Grid.RenderTransform><RotateTransform Angle="0"/></Grid.RenderTransform>
          <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-9,0,0">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#99FFE9C2" Offset="0"/>
                <GradientStop Color="#00FFE9C2" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Ellipse Width="6" Height="6" Fill="#FFFFF4DC" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0"/>
        </Grid>
        <Ellipse x:Name="SignalPulse" Width="216" Height="216" Stroke="{DynamicResource SignalBrush}" StrokeThickness="2"
                 Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="SignalPulseB" Width="216" Height="216" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                 Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
        </Ellipse>
        <Button x:Name="SendButton" Style="{DynamicResource CosmosAction}" Width="212" Height="212" ToolTip="向全部在线同事发出警告">
          <StackPanel Width="164" VerticalAlignment="Center">
            <TextBlock x:Name="ActionTitle" Text="收到一封加急邮件，请立刻处理" FontSize="26" FontWeight="Light" TextOptions.TextFormattingMode="Ideal" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ActionHint" Text="发送给全部在线同事" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
            <Rectangle Width="24" Height="1" Fill="{DynamicResource LineBrush}" Margin="0,12,0,0"/>
            <TextBlock x:Name="HotkeyText" FontFamily="{DynamicResource NumFont}" FontSize="12" Foreground="{DynamicResource FaintBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,9,0,0"/>
          </StackPanel>
        </Button>
        <!-- 冷却进度：发送后 5 秒沿环回退 -->
        <Ellipse x:Name="CooldownGauge" Width="236" Height="236" Stroke="{DynamicResource SignalBrush}" StrokeThickness="2" StrokeDashArray="367.57 600"
                 Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
        </Ellipse>
      </Grid>
    </Grid>

    <!-- 回执 -->
    <Border Grid.Row="2" Style="{StaticResource Glass}"/>
    <Grid Grid.Row="2" Margin="20,0,8,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="112"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
        <TextBlock Text="本次回执" Style="{StaticResource Cap}" HorizontalAlignment="Left"/>
        <TextBlock x:Name="ReceiptSummary" FontSize="13" LineHeight="21" MaxHeight="42" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Margin="0,18" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" ToolTip="对方软件已收到警告">
        <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
          <TextBlock x:Name="ReceivedCount" Text="—" Style="{StaticResource Num}" Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock Text="软件收到" Style="{StaticResource Cap}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Margin="0,18" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" ToolTip="同事本人已点击“知道了”">
        <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
          <TextBlock x:Name="SeenCount" Text="—" Style="{StaticResource Num}" Foreground="{DynamicResource SignalBrush}"/>
          <TextBlock Text="已知晓" Style="{StaticResource Cap}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 在线同事 -->
    <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Glass}"/>
    <DockPanel Grid.Column="2" Grid.RowSpan="3" Margin="18,16,8,14">
      <Grid DockPanel.Dock="Top" Margin="0,0,10,0">
        <StackPanel HorizontalAlignment="Left">
          <TextBlock Text="在线同事" FontSize="14" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
            <Ellipse x:Name="AmbientGlowDot" Width="7" Height="7" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center" Margin="1,1,7,0"/>
            <TextBlock x:Name="ConnectionText" Style="{StaticResource Cap}" MaxWidth="170"/>
          </StackPanel>
        </StackPanel>
        <TextBlock x:Name="OnlineCount" Text="0" Style="{StaticResource Num}" FontSize="36" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Button x:Name="TestButton" DockPanel.Dock="Bottom" Height="36" Margin="0,10,10,0" ToolTip="向在线同事发送一次联机测试，不算正式警告">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource Icon}" Margin="0,0,8,0" Data="M1,7 H4 L6,2 L9,12 L11,7 H14"/>
          <TextBlock Text="联机测试" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Grid Margin="0,12,0,0">
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,10,0"/>
        <TextBlock x:Name="EmptyPeers" Text="暂无其他同事在线&#x0a;同事打开软件后会出现在这里" Style="{StaticResource Cap}" LineHeight="21" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Margin="8,0,18,0" IsHitTestVisible="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0" Focusable="False">
          <ItemsControl x:Name="PeerList" ItemTemplate="{DynamicResource PeerRow}" Focusable="False" Margin="0,0,10,0"/>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Grid>

  <!-- 底栏：网络信息或错误提示 -->
  <DockPanel Grid.Row="2" Margin="26,0,26,2">
    <Path DockPanel.Dock="Left" VerticalAlignment="Center" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 H13 V9 H1 Z M4,12.5 H10 M7,9 V12.5"/>
    <TextBlock x:Name="NetworkText" Style="{StaticResource Cap}" Margin="9,0,0,0"/>
  </DockPanel>
  </Grid>
</Grid>
